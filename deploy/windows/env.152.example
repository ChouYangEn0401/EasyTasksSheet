# 152 server（Windows + nginx + NSSM）用的 .env 範本。
# 複製到 C:\EasyTasksSheet\.env 後，只需要依實際情況改「需要確認」的值。完整變數說明見專案根目錄的 .env.example。
# 存檔：UTF-8（無 BOM）。

# ── 部署（必須與 nginx 的 location /easytasks/ 對應）────────────
NODE_ENV=production
# 只聽本機，外面只能經由 nginx 進來（與 Gitea 3000、pyDMS 8000 相同做法）
HOST=127.0.0.1
# 3000 已被 Gitea 使用、8000 是 pyDMS、8001 保留給 pydms-test，所以用 8100
PORT=8100
# 網址前綴：https://140.112.180.152/easytasks/。改這個值要同時改 nginx，並重新 npm run build
BASE_PATH=/easytasks
# 修改類請求只接受這個來源（瀏覽器網址列的 scheme + host）
APP_ORIGIN=https://140.112.180.152
# nginx 在前面：採用 X-Forwarded-For 的最右段判斷登入失敗的來源 IP
TRUSTED_PROXY=true
# 只經 https 使用
COOKIE_SECURE=true
TZ=Asia/Taipei

# ── 資料（相對於 C:\EasyTasksSheet）──────────────────────────
DATABASE_PATH=data/app.db
ATTACHMENTS_DIR=data/attachments
# 需要確認：備份建議放 C 槽以外（第二顆磁碟或 NAS），例如 D:/backup/easytasks
BACKUP_DIR=backups
BACKUP_KEEP=14

# ── 首次啟動的預設管理員（首次登入會被要求改帳號與密碼）──────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 選用功能（留空 = 停用）──────────────────────────────────
WORKTREE_REPORT_TOKEN=
WORKTREE_SCAN_ROOTS=
GITHUB_TOKEN=
