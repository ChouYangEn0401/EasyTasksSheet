{
  "name": "tasks-sheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.1.11",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.108.4",
    "better-sqlite3": "^13.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green npm:dev:server npm:dev:web",
    "dev:server": "node --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db.ts migrate",
    "db:seed": "node scripts/db.ts seed",
    "db:setup": "node scripts/db.ts setup",
    "user:add": "node scripts/user-add.ts",
    "backup": "node scripts/backup.mjs",
    "backup:self-test": "node scripts/backup.mjs --self-test",
    "py:install": "node scripts/py.mjs install",
    "py:test": "node scripts/py.mjs -m pytest server",
    "dev:py": "node scripts/py.mjs -m server.app --reload"
  }
}
