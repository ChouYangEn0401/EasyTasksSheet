{
  "name": "tasks-sheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.108.4",
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green npm:dev:py npm:dev:web",
    "dev:py": "node scripts/py.mjs -m server.app --reload",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node scripts/py.mjs NODE_ENV=production -m server.app",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "py:install": "node scripts/py.mjs install",
    "py:test": "node scripts/py.mjs -m pytest server",
    "check": "npm run lint && npm run typecheck && npm run test && npm run py:test && npm run build",
    "user:add": "node scripts/py.mjs -m server.cli user-add",
    "backup": "node scripts/py.mjs -m server.cli backup",
    "backup:self-test": "node scripts/py.mjs -m server.cli backup --self-test"
  }
}
