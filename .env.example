# 複製為 .env 後依需要修改。所有變數皆有預設值（見 src/server/config.ts）。

# ── 基本 ──────────────────────────────────────────────
# development | production | test
NODE_ENV=development
HOST=0.0.0.0
# API 連接埠（worktree 軌道用 3100+n）
PORT=3000
# Vite 開發伺服器連接埠（worktree 軌道用 5200+n）
WEB_PORT=5173
# 允許的前端來源（修改類請求檢查 Origin）；未設定時接受與 Host 相同的來源
APP_ORIGIN=
# SQLite 檔路徑（每個 worktree 用獨立檔）
DATABASE_PATH=data/app.db
# 正式模式提供的前端靜態檔目錄
STATIC_DIR=dist/web
# 時區
TZ=Asia/Taipei

# ── Session / 登入 ────────────────────────────────────
# 絕對期限（小時，不續期）
SESSION_MAX_HOURS=9
# 閒置逾時（分鐘）
SESSION_IDLE_MINUTES=60
# cookie Secure 旗標；未設定時正式環境為 true
COOKIE_SECURE=
# 登入失敗限制：同帳號於視窗內失敗 N 次鎖定；同 IP 於視窗內失敗 N 次暫拒
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILS_PER_USER=5
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_FAILS_PER_IP=20
# 首次啟動建立的管理員；未設定密碼則產生隨機密碼並只在主控台顯示一次
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 同步 ──────────────────────────────────────────────
# changes 變更流水保留天數
CHANGES_RETENTION_DAYS=30

# ── 工程追蹤（feat/eng-tracking）──────────────────────
# GitHub 唯讀 token（不設定則 issue 頁顯示提示）
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# issue 快取分鐘數
ISSUE_CACHE_MINUTES=5
# worktree 超過幾天未更新視為久未更新
WORKTREE_STALE_DAYS=7
# 開發機以 scripts/report-worktrees.mjs 回報時使用的 token（模式 B）。
# 回報端點 POST /api/eng/worktrees/report 免登入，只以此 token 驗證（不需帳號密碼）；
# 開發機執行腳本時設定同一個值的環境變數 WORKTREE_REPORT_TOKEN。
# 留空 = 停用回報（端點一律回 403）。請使用夠長的隨機字串，例如：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKTREE_REPORT_TOKEN=
# 執行 git 指令的逾時（毫秒）
GIT_TIMEOUT_MS=10000

# ── 備份（scripts/backup.mjs，npm run backup）──────────
# 備份輸出目錄
BACKUP_DIR=backups
# 保留最近幾份備份（超過的舊備份自動刪除）
BACKUP_KEEP=14

# ── E2E（Playwright）─────────────────────────────────
# E2E 測試伺服器連接埠
E2E_PORT=3999
