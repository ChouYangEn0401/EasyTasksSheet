# 複製為 .env 後依需要修改。所有變數皆有預設值（見 server/app/config.py）；空值視同未設定。
# 啟動（python main.py）與管理指令（python -m server.cli）都從「工作目錄」讀取 .env，
# 已存在的系統環境變數優先。

# ── 基本 ──────────────────────────────────────────────
# development | production | test（production 時 cookie 預設 Secure）。舊名 NODE_ENV 仍可用，APP_ENV 優先
APP_ENV=development
# 監聽位址，預設只有本機能連（127.0.0.1）。要讓區網其他電腦直接連，改成 0.0.0.0（建議改放反向代理後面）
HOST=127.0.0.1
# 後端連接埠（worktree 軌道用 3100+n）
PORT=3000
# 允許的前端來源（修改類請求檢查 Origin），例如 https://tasks.lab.example；未設定時接受與 Host 相同的來源
APP_ORIGIN=
# SQLite 檔路徑（相對於工作目錄；每個 worktree 用獨立檔）
DATABASE_PATH=data/app.db
# 掛在反向代理的子路徑底下時的網址前綴，例如 /easytasks（對應 nginx 的 location /easytasks/）；空 = 網站根目錄。
# 前端的 index.html 由伺服器在每次請求時代入這個值，改了只要重啟。範例見 docs/DEPLOY-152.md
BASE_PATH=
# 時區
TZ=Asia/Taipei

# ── Session / 登入 ────────────────────────────────────
# 絕對期限（小時，不續期）
SESSION_MAX_HOURS=9
# 閒置逾時（分鐘）
SESSION_IDLE_MINUTES=60
# cookie Secure 旗標（true / false）；未設定時正式環境為 true
COOKIE_SECURE=
# 登入失敗限制：同帳號於視窗內失敗 N 次鎖定；同 IP 於視窗內失敗 N 次暫拒
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILS_PER_USER=5
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_FAILS_PER_IP=20
# 是否信任反向代理的 X-Forwarded-For（true / false）。經 Caddy/nginx 反向代理時必須設 true
# （否則所有人共用 127.0.0.1 這個 IP 桶）；直連 uvicorn、沒有反向代理則維持 false（忽略該標頭，防偽造）
TRUSTED_PROXY=false
# 首次啟動（尚無任何帳號時）建立的預設管理員，預設 admin / password；
# 首次登入強制重設帳號與密碼。可選覆寫，留空即使用預設值
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 同步 ──────────────────────────────────────────────
# changes 變更流水保留天數（即時同步補漏用）；啟動時與每日自動修剪（須 > 0）
CHANGES_RETENTION_DAYS=30
# 稽核紀錄（後台「稽核紀錄」頁，docs/design/audit-log.md）保留天數；啟動時與每日自動修剪
AUDIT_RETENTION_DAYS=365
# 在線感知（docs/multi-user.md）：最後一次回報在幾秒內算「在線」、幾秒內算「閒置」（超過即離線）
# 測試可縮短（E2E 用 10 / 25）；presence 回報不會延長登入的閒置逾時
PRESENCE_ONLINE_SECONDS=45
PRESENCE_IDLE_SECONDS=300

# ── 工程追蹤：開發機回報 worktree ──────────────────────
# 各人電腦以 scripts/report_worktrees.py 回報 worktree 狀態時使用的 token。
# 回報端點 POST /api/eng/worktrees/report 免登入，只以此 token 驗證（不需帳號密碼）；
# 開發機執行腳本時設定同一個值的環境變數 WORKTREE_REPORT_TOKEN。
# 留空 = 停用回報（端點一律回 403）。請使用夠長的隨機字串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKTREE_REPORT_TOKEN=
# 電腦超過幾天沒有回報，工作樹頁面標示「未回報（最後看到 N 天前）」（只是提示，資料不會刪除）
WORKTREE_STALE_DAYS=2

# ── 工程追蹤：掃描本機專案（網頁「掃描本機專案」按鈕）──────
# 允許在「伺服器這台電腦」上掃描的資料夾，逗號分隔，例如 C:\work,D:\repos 或 /home/me/src。
# 只會掃描這些資料夾內的專案（以真實路徑比對，`..` 與符號連結無法跳出）；git 只做唯讀查詢，不 fetch、不執行 hook。
# 留空 = 停用此功能（頁面上會說明如何啟用）。使用權限 eng.scan 預設為管理者以上，root 可在「權限設定」調整。
# 在自己電腦上也可直接執行：python -m server.cli scan-worktrees <專案資料夾>（不受此設定限制）
WORKTREE_SCAN_ROOTS=
# 伺服器端 git 指令（掃描本機專案、python -m server.cli scan-worktrees）的逾時毫秒數；
# 回報腳本 scripts/report_worktrees.py 也讀同名環境變數（預設 10000）
GIT_TIMEOUT_MS=10000

# ── 工程追蹤：問題的附件 ──────────────────────────────
# 附件檔案存放目錄（檔名為隨機 id；systemd 的 ReadWritePaths / Docker volume 要包含此目錄）。
# `python -m server.cli backup` 會把附件一併備份到 <備份檔>.attachments/
ATTACHMENTS_DIR=data/attachments
# 一般檔案單檔上限（MB）
ATTACHMENT_MAX_MB=25
# 影片（mp4 / webm / mov）單檔上限（MB）。反向代理也要放寬請求大小與逾時：
#   Caddy：request_body { max_size 210MB }（見 deploy/linux/Caddyfile）；nginx：client_max_body_size 210m;
ATTACHMENT_VIDEO_MAX_MB=200
# 每筆問題最多幾個附件
ATTACHMENT_MAX_PER_ITEM=10

# ── 工程追蹤：連結預覽（抓取網頁標題 / 說明 / 縮圖等 metadata，不含整頁截圖）──
# false = 停用（不連網）
LINK_PREVIEW_ENABLED=true
# 是否允許抓取內網 / 本機位址（127.0.0.1、10.x、192.168.x、169.254.169.254 …）。
# 開啟後任何成員都能讓伺服器連到內網（SSRF 風險），預設 false；只建議在 E2E 測試或完全隔離的內網使用
LINK_PREVIEW_ALLOW_PRIVATE=false

# ── 備份（python -m server.cli backup）────────────────
# 備份輸出目錄（建議指向另一顆磁碟或 NAS；systemd unit 的 ReadWritePaths 也要包含）
BACKUP_DIR=backups
# 保留最近幾份備份（超過的舊備份自動刪除）
BACKUP_KEEP=14
# 「資料管理」匯入檔大小上限（MB）；匯入前的自動備份同樣寫入 BACKUP_DIR
DATA_IMPORT_MAX_MB=50
# 整站搬家包（.etpack，資料管理 → 整站搬家包）上傳還原的大小上限（MB）。
# 反向代理的上傳上限要放寬到此值以上（nginx：client_max_body_size），否則大檔請改用 python -m server.cli pack-import
PACK_MAX_MB=2048

# ── 多台電腦同步（python -m server.cli sync-push，docs/sync.md）────
# 同一筆資料兩邊都改過時：更新時間差距超過幾分鐘就自動採較新者；差距在此之內則列為「待確認衝突」交給管理者決定
# （上傳大小上限沿用 DATA_IMPORT_MAX_MB；自動備份寫入 BACKUP_DIR，每個來源每天一份）
SYNC_AUTO_RESOLVE_MINUTES=10

# ── 選配：GitHub 連動（工程追蹤） ─────────────────────────
# 空 = 停用（不連網、畫面不顯示 GitHub 按鈕）。token 只存在 server 端，不會傳到瀏覽器。
# 權限：fine-grained 選定 repo 的 Issues 讀取（同步 / 匯入）；要在 GitHub 建立 issue 需 Issues 讀寫。classic token 用 repo 範圍。
GITHUB_TOKEN=
# GitHub API 位址（GitHub Enterprise 可改）
GITHUB_API_URL=https://api.github.com
# 開啟問題列表時，距上次同步超過幾分鐘就自動同步一次
GITHUB_SYNC_MINUTES=5
